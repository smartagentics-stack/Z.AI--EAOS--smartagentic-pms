{
  "name": "smartagentics",
  "private": true,
  "version": "0.1.0-alpha.0",
  "description": "SmartAgentics AI Enterprise Platform \u2014 Hotel PMS (Phase 1)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:fitness": "vitest run --config tests/fitness/vitest.config.ts",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "bootstrap": "pnpm install && pnpm db:generate && pnpm test && pnpm test:fitness",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "verify": "tsx packages/engineering-assurance/src/cli.ts",
    "verify:governance": "tsx packages/engineering-assurance/src/cli.ts governance",
    "verify:adr": "tsx packages/engineering-assurance/src/cli.ts adr",
    "verify:evidence": "tsx packages/engineering-assurance/src/cli.ts evidence",
    "verify:architecture": "tsx packages/engineering-assurance/src/cli.ts architecture",
    "verify:serialization": "tsx packages/engineering-assurance/src/cli.ts serialization",
    "verify:security": "tsx packages/engineering-assurance/src/cli.ts forbidden",
    "verify:dependencies": "tsx packages/engineering-assurance/src/cli.ts dependencies",
    "verify:traceability": "tsx packages/engineering-assurance/src/cli.ts traceability",
    "verify:prompt": "tsx packages/engineering-assurance/src/cli.ts prompt",
    "verify:performance": "tsx packages/engineering-assurance/src/cli.ts performance",
    "verify:ear": "tsx packages/engineering-assurance/src/cli.ts all"
  },
  "devDependencies": {
    "@smartagentics/dev-config": "workspace:*",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}

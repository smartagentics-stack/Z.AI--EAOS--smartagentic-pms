# SmartAgentics AI PMS — Environment Variables
#
# Copy this file to .env and fill in the values.
# In production, set these as environment variables in your deployment system.

# ─── Required ────────────────────────────────────────────────────────────────

# Database URL (SQLite path for Phase 1)
# Format: file:./prisma/dev.db (relative to packages/db/)
DATABASE_URL="file:./dev.db"

# Authentication secret for session signing (minimum 16 characters)
# Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-secure-secret-min-16-chars"

# ─── Optional ────────────────────────────────────────────────────────────────

# Node environment (development | test | production)
NODE_ENV="development"

# Log level (debug | info | warn | error)
LOG_LEVEL="info"

# Web server port (default: 3000)
PORT=3000

# OpenAI API key (required for AI features — Sprint 4)
# OPENAI_API_KEY="sk-..."
